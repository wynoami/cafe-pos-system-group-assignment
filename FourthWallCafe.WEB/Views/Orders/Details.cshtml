@model FourthWallCafe.Web.ViewModels.OrderDetailsViewModel

<!-- Header Row -->
<div class="row mb-4 align-items-center">
    <div class="col">
        <h2>Order #@Model.OrderId</h2>
    </div>
    <div class="col text-end">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary border-2">Cancel Order</a>
    </div>
</div>

<div class="row">
    <!-- LEFT COLUMN: The MenuInterface (Takes up 8 of 12 grid spaces) -->
    <div class="col-md-8">

        <!-- Category Navigation -->
        <div class="m b-4">
            <h4 class="text-muted mb-3">Categories</h4>
            <div class ="d-flex gap-2 flex-wrap">
               
               <!-- "All Items" Button -->
               <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId"
                  class= "btn btn-outline-dark px-4 py-2 fw-bold">
                  All 
               </a>

               <!-- Dynamic Category Buttons -->
               @foreach (var category in Model.MenuCategories)
               {
                    <!-- Use asp-route-categoryId to pass the specific ID back to the controller -->
                    <a asp-controller="Orders"
                       asp-action="Details"
                       asp-route-id="@Model.OrderId"
                       asp-route-categoryId="@category.CategoryId"
                       class="btn btn-outline-primary px-4 py-2 fw-bold" >
                        @category.Name
                    </a>
               }
            </div>
        </div>

        <hr />

        <!-- Menu Item Grid -->
        <div class="mb-4">
            <h4 class="text-muted mb-3">Menu Items</h4>
            <div class="row row-cols-2 row-cols-md-3 g-3">
                @foreach (var item in Model.MenuItems)
                {
                    <div class="col">
                        <div class="card h-100 border-dark shadow-sm text-center">
                            <div class-"card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">@item.Name</h5>
                                <p class="card-text text-success fs-5 mb-4">@item.CurrentPrice.ToString("0.00")</p>

                                <!-- Form to add th eitem to the ticket -->
                                <form asp-controller="Orders" asp-action="AddItem" method="post" class="mt-auto">
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-dark w-100">Add to Ticket</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: The Running Ticket (Takes up 4 of 12 grid spaces) -->
    <div class="col-md-4">
        <div class="card border-dark shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0 text-center">Current Ticket</h4>
            </div>

            <div class="card-body p-0 overflow-auto" style="max-height: 500px;">
                <ul class="list-group list-group-flush">
                    @if (Model.CurrentOrderItems.Count == 0)
                    {
                        <li class="list-group-item text-muted text-center py-5">No items added yet.</li>
                    }
                    else
                    {
                        @foreach (var orderItem in Model.CurrentOrderItems)
                        {
                            <li class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold fs-5">@orderItem.ItemName</span>
                                    <span class="fw-bold">@orderItem.Subtotal.ToString("0.00")</span>
                                </div>
                                <div class="text-muted">
                                    Qty: @orderItem.Quantity
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>

            <!-- Ticket Footer -->
            <div class="card-footer bg-light p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Total:</h4>
                    <h4 class="mb-0 text-success fw-bold">@Model.OrderTotal.ToString("0.00")</h4>
                </div>
                <button class="btn btn-success w-100 btn-lg fw-bold">Send to Kitchen</button>
            </div>
        </div>
    </div>
</div>