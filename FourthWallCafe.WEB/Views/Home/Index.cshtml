@model FourthWallCafe.Web.ViewModels.HomeViewModel

<div class="text-center mt-5">
    <h1>4th Wall Cafe POS</h1>

    <!-- New Order Button -->
    <div class="mt-5 mb-4">
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary btn-lg border border-dark px-5 py-3">Create New Order</a>
    </div>

    <!-- Active Orders List -->
   <div class="mt-5">
    <h3>Active Orders</h3>
    <hr class="w-50 mx-auto"/>
    @* Check if the list is empty *@
    @if (Model.OpenOrders == null || !Model.OpenOrders.Any())
    {
            <p class="text-muted mt-4">No open orders at this time.</p>
    }
    else
    {
        @* If we have orders, loop through them and create a button for each! *@
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
        @foreach (var order in Model.OpenOrders)
        {
            <a asp-controller="Orders" asp-action="Details" asp-route-id="order.OrderId" class="btn btn-outline-dark btn-lg px-4 py-3 fw-bold shadow-sm">
                Ticket #@order.OrderId
            </a>
        }
        </div>
    }

   </div>
</div>