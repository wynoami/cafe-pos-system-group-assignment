<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>4th Wall Cafe POS</title>
    <!-- This link brings in Bootstrap to style the buttons and layout -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- MAIN NAVIGAION BAR -->
    <header>
    <nav class="navbar navbar-dark bg-dark border-bottom box-shadow mb-4 py-3">
        <div class="container-fluid d-flex align-items-center justify-content-start gap-4">
            
            <!-- Brand Logo / Name -->
            <a class="navbar-brand fw-bold mb-0 fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                ☕ 4th Wall Cafe
            </a>
            
            <!-- Functional Navigation Links -->
            <a class="nav-link text-light fs-5" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="nav-link text-light fs-5" asp-area="" asp-controller="Orders" asp-action="Create">New Order</a>
            
        </div>
    </nav>
</header>

    <!-- MAIN CONTENT AREA -->
    <div class="container mt-4">
        <!-- This is where your Index.cshtml and Create.cshtml get injected -->
        @RenderBody() 
    </div>

    <!-- Bootstrap JS for interactive components (like the mobile menu toggle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>